# Copy to .env.local for local work, or paste these into your host's env-var settings.
# .env.local is gitignored; never commit real keys.

# ---- required everywhere -------------------------------------------------
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# ---- speech to text ------------------------------------------------------
# "whisper" (default) talks to whisper_server.py on this machine. mlx-whisper needs
# Apple Silicon and Metal, so it CANNOT run on Vercel/Render/Netlify — a hosted deploy
# left on the default returns 503 whisper_offline for every turn.
# Set this to "sarvam" for anything hosted.
STT_PROVIDER=whisper
SARVAM_API_KEY=
# WHISPER_URL=http://127.0.0.1:8123/transcribe

# ---- guard rails for a public URL ---------------------------------------
# Defaults (600/min) are sized for local testing. A public link is a public bill:
# every TTS character is billed to the key above, so tighten these when hosting.
# TTS_RATE_LIMIT=20
# STT_RATE_LIMIT=40
# DEMO_RATE_LIMIT=40
# TTS_MAX_CHARS=400

# ---- local only ----------------------------------------------------------
# Writes profiles/<slug>.json + zeone.db for the Python agent. Serverless filesystems
# are read-only, so leave this unset when hosting.
# ZEONE_ALLOW_PROVISION=1
